# ── Variables de entorno ────────────────────────────────────
# Copiar a .env y ajustar según entorno
# cp .env.example .env

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Base de datos
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=taskmanager
DB_USERNAME=taskman
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root_secret

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Mail (log para desarrollo)
MAIL_MAILER=log
