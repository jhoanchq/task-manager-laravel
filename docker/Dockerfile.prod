# =============================================================================
# Dockerfile.prod — Producción (imagen optimizada y más segura)
# =============================================================================
# Multi-etapa: compilación → producción
# No incluye: Composer, Node, build tools
# No usa bind mount — todo va dentro de la imagen

# ── ETAPA 1: Dependencias ─────────────────────────────────────────────
FROM php:8.3-fpm-alpine AS vendor

RUN apk add --no-cache git unzip curl libzip-dev oniguruma-dev

# Extensiones PHP
RUN docker-php-ext-install pdo_mysql mbstring zip bcmath pcntl \
    && pecl install redis && docker-php-ext-enable redis

# Composer
COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer

WORKDIR /build
COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

# ── ETAPA 2: Frontend ────────────────────────────────────────────────
FROM node:22-alpine AS frontend
WORKDIR /build
COPY package.json package-lock.json* vite.config.js postcss.config.js tailwind.config.js ./
RUN npm ci
COPY resources/ resources/
RUN npm run build

# ── ETAPA 3: Producción ──────────────────────────────────────────────
FROM php:8.3-fpm-alpine

RUN apk add --no-cache unzip libzip-dev oniguruma-dev nginx supervisor \
    && docker-php-ext-install pdo_mysql mbstring zip bcmath pcntl \
    && pecl install redis && docker-php-ext-enable redis

WORKDIR /var/www

# Copiar código fuente
COPY . .

# Copiar vendor desde etapa 1
COPY --from=vendor /build/vendor /var/www/vendor

# Copiar frontend compilado desde etapa 2
COPY --from=frontend /build/public/build /var/www/public/build

# Configuración producción
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/supervisord.conf /etc/supervisord.conf

# Storage debe ser montado como volumen en producción
RUN mkdir -p /var/www/storage/logs

# Permisos
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache \
    && chmod -R 775 /var/www/storage /var/www/bootstrap/cache

# Optimización Laravel
RUN php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache

EXPOSE 9000
CMD ["php-fpm"]
